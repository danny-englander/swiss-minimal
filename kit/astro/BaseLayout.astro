---
// A starting layout for an Astro site in this style, built on Tailwind v4. Copy it, then edit.
// Needs the whole kit/ folder next to it (tailwind.css, theme.css, panel.js, astro/) and
// fonts/ beside kit/. It does not import any CSS itself: import your site's global
// stylesheet (which starts with `@import "<path>/kit/tailwind.css";`) in your own layout.
import font from '../../fonts/OverusedGrotesk-VF.woff2?url';
import MenuButton from './MenuButton.astro';
import MenuPanel from './MenuPanel.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { MenuItem } from './types';

interface Props {
  title: string;
  description?: string;
  /** The slide-down menu. Items with `children` become accordions. */
  menu?: MenuItem[];
  /** Small text at the left of the top bar. */
  tagline?: string;
  /** Height of a fixed bottom bar, if the site has one (e.g. "5rem"). The panel and toast stop above it. */
  barHeight?: string;
}
const { title, description, menu = [], tagline = '', barHeight = '0rem' } = Astro.props;
---

<!doctype html>
<html lang="en" style={`--bar-h: ${barHeight}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#f3f0e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0c" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply a saved theme before first paint so there is no flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <div class="topbar">
      <div class="page">
        <div class="flex items-center justify-between border-b-2 border-current py-3">
          <p class="text-sm font-medium">{tagline}</p>
          <div class="flex items-center gap-2">
            {menu.length > 0 && <MenuButton />}
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>

    {
      menu.length > 0 && (
        <MenuPanel items={menu}>
          <slot name="panel" />
        </MenuPanel>
      )
    }

    <!-- Everything else goes in here: it becomes inert while the panel is open.
         The bottom padding keeps the end of the page clear of a fixed bottom bar. -->
    <div data-panel-page class="pb-(--bar-h)">
      <div class="page">
        <slot />
      </div>
    </div>
  </body>
</html>
