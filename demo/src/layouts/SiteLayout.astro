---
// The demo's page shell: the kit's BaseLayout with a tabbed panel (Menu, Contact, Features),
// the "new" dot, a Recent drawer, a fixed bottom bar with a scrolling title and a
// jump-to-current button, and the toast.
import BaseLayout from '../design/kit/astro/BaseLayout.astro';
import DrawerButton from '../design/kit/astro/DrawerButton.astro';
import FeaturesList from '../design/kit/astro/FeaturesList.astro';
import RecentDrawer from '../components/RecentDrawer.astro';
import AccentSwitcher from '../components/AccentSwitcher.astro';
import { menuFor } from '../data/menu';
import { features, latestFeatureDate } from '../data/features';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'A Swiss / Bauhaus design kit for Astro and Tailwind v4: type-led, flat color, thick rules, one typeface.',
} = Astro.props;
const pageTitle = `${title} · Swiss Minimal`;
// Share tags need full URLs, so they are built on `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/share-dark.png', Astro.site);
const nowReading =
  'Field notes: twelve months of small projects set in a single typeface, and what that taught me about restraint';
const tabs = [
  { id: 'menu', label: 'Menu' },
  { id: 'contact', label: 'Contact' },
  { id: 'features', label: 'Features' },
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  menu={menuFor(Astro.url.pathname)}
  panelTabs={tabs}
  newDot={{
    latest: latestFeatureDate,
    tab: 'features',
    key: 'swiss-demo:features-seen',
    // Not swiss-demo:recent: every page saves that on load, so a first visit would count.
    returning: ['theme', 'favorites'],
  }}
  tagline="Swiss Minimal demo"
  barHeight="5rem"
>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Share previews. A preview can't follow the reader's theme, so it uses the dark card;
         public/share-light.png is the same card in light. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Swiss Minimal" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Swiss Minimal, in large bold type beside an abstract composition of black, grey and red shapes" />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <script is:inline slot="head">
    // Demo only: apply the accent picked in the gear switcher before first paint.
    try {
      const accent = localStorage.getItem('swiss-demo:accent');
      if (accent === 'teal') document.documentElement.dataset.accent = accent;
    } catch {}
  </script>

  <DrawerButton slot="topbar" label="Recent pages">Recent</DrawerButton>

  <!-- Netlify Forms finds this form in the built HTML (name, data-netlify) and keeps the messages
       under Forms in the Netlify dashboard. bot-field is a honeypot: people never see it, so a
       submission that fills it in is spam. -->
  <form
    slot="contact"
    class="max-w-xl border-t-2 border-current pt-3"
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-contact-form
  >
    <input type="hidden" name="form-name" value="contact" />
    <p hidden><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <p class="label mb-2 font-bold text-accent-bright">Contact</p>
    <p class="small mb-6 text-bar-ink/85"><span class="required-mark"></span>Required</p>
    <label class="field-label" for="contact-name">Your name</label>
    <input class="field mb-7" id="contact-name" name="name" autocomplete="name" placeholder="Jane Doe" required />
    <label class="field-label" for="contact-email">Email</label>
    <input class="field mb-7" id="contact-email" name="email" type="email" autocomplete="email" placeholder="jane@example.com" required />
    <label class="field-label" for="contact-topic">Topic</label>
    <div class="select-wrap mb-7">
      <select class="field select" id="contact-topic" name="topic">
        <option>General</option>
        <option>A project</option>
        <option>The design kit</option>
      </select>
    </div>
    <label class="field-label" for="contact-message">Message</label>
    <textarea class="field mb-7 min-h-24 resize-y" id="contact-message" name="message" rows="3"></textarea>
    <button class="btn" type="submit">Send</button>
    <!-- The toast sits behind the open panel, so a failure is said here, beside the button. -->
    <p class="small mt-4 font-bold text-accent-bright empty:mt-0" role="alert" data-contact-error></p>
  </form>

  <div slot="features" class="max-w-4xl">
    <h2 class="h2">Features</h2>
    <p class="lead mt-6 mb-10 max-w-2xl">What this demo can do, and when each part arrived. Newest first.</p>
    <FeaturesList features={features} />
  </div>

  <RecentDrawer slot="overlays" />

  <slot />

  <AccentSwitcher />

  <div class="fixed inset-x-0 bottom-0 z-40 h-(--bar-h) bg-bar text-bar-ink" data-jump-bar data-drawer-keep>
    <div class="page flex h-full items-center gap-4">
      <p class="label flex flex-none items-center gap-2 font-bold text-accent-bright">
        Now
        <button type="button" class="jump-btn" data-jump data-jump-target='[data-item="field-notes"]' data-jump-name="Field notes" hidden>
          <span aria-hidden="true" data-jump-glyph>▲</span>
        </button>
      </p>
      <span class="marquee min-w-0 flex-1 text-lg font-medium" title={nowReading} data-marquee>
        <span>{nowReading}</span>
      </span>
    </div>
  </div>

  <div class="toast" role="status" data-toast data-drawer-keep></div>
</BaseLayout>

<script>
  import '../design/kit/jump.js';

  // Marquee: from COMPONENTS.md. Three rounds, then rest with an ellipsis. Never with Reduce Motion.
  function scrollTitle(el: HTMLElement) {
    const distance = el.scrollWidth - el.clientWidth;
    if (distance <= 4 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const pause = 2000;
    const slide = Math.max(1500, (distance / 50) * 1000);
    const total = 2 * pause + 2 * slide;
    const end = `translateX(-${distance}px)`;
    el.dataset.scrolling = '';
    const inner = el.firstElementChild as HTMLElement;
    inner.animate(
      [
        { transform: 'none', offset: 0 },
        { transform: 'none', offset: pause / total, easing: 'ease-in-out' },
        { transform: end, offset: (pause + slide) / total },
        { transform: end, offset: (2 * pause + slide) / total, easing: 'ease-in-out' },
        { transform: 'none', offset: 1 },
      ],
      { duration: total, iterations: 3 },
    ).onfinish = () => {
      delete el.dataset.scrolling;
    };
  }
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  if (marquee) document.fonts.ready.then(() => scrollTitle(marquee));

  // Toast: any script can show one with
  //   document.dispatchEvent(new CustomEvent('toast', { detail: 'Saved.' }))
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let timer: number | undefined;
  function showToast(text: string) {
    if (!toast) return;
    toast.textContent = text;
    toast.dataset.show = 'true';
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      delete toast.dataset.show;
    }, 4000);
  }
  document.addEventListener('toast', (e) => showToast(String((e as CustomEvent).detail)));

  // Contact form: sent to Netlify Forms without leaving the page. Only once Netlify accepts it
  // does the panel close with a thank-you; otherwise the message stays put to try again.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const error = form?.querySelector<HTMLElement>('[data-contact-error]');
  const send = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!send || !error) return;
    send.disabled = true;
    error.textContent = '';
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      document.dispatchEvent(new Event('menu:close'));
      showToast('Message sent. Thank you.');
    } catch {
      error.textContent = 'Couldn’t send your message. Check your connection and try again.';
    } finally {
      send.disabled = false;
    }
  });
</script>
