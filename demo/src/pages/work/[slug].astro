---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { work, type WorkItem } from '../../data/work';

export const getStaticPaths = (() =>
  work
    .filter((w) => w.slug)
    .map((item) => ({ params: { slug: item.slug }, props: { item } }))) satisfies GetStaticPaths;

interface Props {
  item: WorkItem;
}
const { item } = Astro.props;
---

<SiteLayout title={item.title} description={item.body?.[0]}>
  <article class="max-w-2xl pt-12 pb-16 [&>p]:mb-5">
    <a class="link small mb-8 inline-block" href="/work">All work</a>
    <h1 class="h2 mb-3">{item.title}</h1>
    {item.meta && <p class="small muted">{item.meta}</p>}
    {item.body?.map((p) => <p>{p}</p>)}
    {
      item.site && (
        <p>
          <a class="link" href={item.site} target="_blank" rel="noopener noreferrer">
            Site
            <span class="ml-1 inline-block align-[-0.08em] text-[1.3em] leading-none" aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </p>
      )
    }
  </article>
</SiteLayout>
