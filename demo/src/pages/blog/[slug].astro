---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostHeader from '../../design/kit/astro/PostHeader.astro';
import PostNav from '../../design/kit/astro/PostNav.astro';
import { getPosts, href, minutes, type BlogEntry } from '../../data/blog';

// Posts are newest first, so the one before in the list is newer ("Next") and the one after is
// older ("Previous").
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: BlogEntry;
  newer?: BlogEntry;
  older?: BlogEntry;
}
const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { cover } = entry.data;
const link = (e?: BlogEntry) => e && { title: e.data.title, href: href(e) };
---

<SiteLayout title={entry.data.title} description={entry.data.summary}>
  <article class="pb-4">
    <PostHeader
      title={entry.data.title}
      lead={entry.data.summary}
      back={{ label: 'Blog', href: '/blog/' }}
      date={entry.data.date}
      author={entry.data.author}
      minutes={minutes(entry)}
      tags={entry.data.tags}
    />
    {
      // A landscape cover runs the width of the page at 16:9; a square or portrait one keeps
      // its shape at the text's width, so it is never cropped to a strip.
      cover &&
        (cover.width > cover.height ? (
          <Image
            class="media media--16x9 mb-12"
            src={cover}
            alt={entry.data.coverAlt ?? ''}
            widths={[640, 1280, 1760]}
            sizes="(min-width: 88rem) 88rem, 100vw"
            loading="eager"
          />
        ) : (
          <Image
            class="media mb-12 max-w-2xl"
            src={cover}
            alt={entry.data.coverAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(min-width: 42rem) 42rem, 100vw"
            loading="eager"
          />
        ))
    }
    <div class="post-body">
      <Content />
    </div>
  </article>
  <PostNav prev={link(older)} next={link(newer)} />
</SiteLayout>
