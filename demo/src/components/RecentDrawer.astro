---
// "Recent pages": the kit's Drawer, filled in the browser with the pages opened on this
// device, newest first. Shows the drawer, its "more below" arrow, the closing note, and
// IconActions: three brand marks, an action icon and a remove button per row.
import Drawer from '../design/kit/astro/Drawer.astro';
import IconTemplates from '../design/kit/astro/IconTemplates.astro';
---

<!-- Rows are built in the browser, so each icon is rendered once here and cloned per row. -->
<IconTemplates
  icons={{
    bluesky: 'simple-icons:bluesky',
    instagram: 'simple-icons:instagram',
    youtube: 'simple-icons:youtube',
    copy: 'material-symbols:content-copy-outline',
    remove: 'material-symbols:cancel-outline',
  }}
/>

<Drawer title="Recent pages" moreLabel="Scroll to more pages">
  <p slot="before" data-recent-empty class="mt-6 max-w-md">Nothing yet. Pages you open here are listed.</p>
  <p class="closing-note mt-6 max-w-md">Kept on this device only.</p>
</Drawer>

<script>
  import { focusAfterRemoval, iconControl } from '../design/kit/icon-controls.js';

  const KEY = 'swiss-demo:recent';
  const MAX = 20;

  interface Visit {
    path: string;
    title: string;
    at: number;
  }

  function load(): Visit[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(KEY) ?? '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  function save(visits: Visit[]) {
    try {
      localStorage.setItem(KEY, JSON.stringify(visits));
    } catch {}
  }

  const list = document.querySelector<HTMLOListElement>('[data-drawer-list]');
  const empty = document.querySelector<HTMLElement>('[data-recent-empty]');
  const heading = document.querySelector<HTMLElement>('[data-drawer-focus]');
  const toast = (text: string) => document.dispatchEvent(new CustomEvent('toast', { detail: text }));

  /** "14:05", or "Oct 11, 14:05" for an earlier day. */
  function when(at: number) {
    const d = new Date(at);
    const time = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    if (d.toDateString() === new Date().toDateString()) return time;
    return `${d.toLocaleDateString([], { month: 'short', day: 'numeric' })}, ${time}`;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  // Titles are only ever set as text, never as HTML.
  function render(visits: Visit[]) {
    if (!list || !empty) return;
    list.replaceChildren(
      ...visits.map((v) => {
        const item = el('li', 'drawer-item');
        const body = el('div', 'min-w-0');
        const link = el('a', 'drawer-title block underline-offset-4 hover:underline', v.title);
        link.href = v.path;
        const meta = el('p', 'drawer-meta');
        const time = el('time', '', when(v.at));
        time.dateTime = new Date(v.at).toISOString();
        meta.append(`${v.path} · `, time);
        body.append(link, meta);

        // Icon-only actions. Each name says what it does, verb first; the hover label is the
        // part before the colon ("Share on Bluesky").
        const url = new URL(v.path, location.origin).href;
        const actions = el('p', 'icon-row');
        const external = (icon: string, action: string, href: string) => {
          const a = iconControl('a', icon, `${action}: ${v.title} (opens in a new tab)`) as HTMLAnchorElement;
          a.href = href;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          return a;
        };
        const share = external(
          'bluesky',
          'Share on Bluesky',
          `https://bsky.app/intent/compose?text=${encodeURIComponent(`${v.title} ${url}`)}`,
        );
        // Instagram has no web search or share link that works signed out; its hashtag page does.
        const tag = v.title.toLowerCase().replace(/[^a-z0-9]/g, '');
        const instagram = external('instagram', 'Search on Instagram', `https://www.instagram.com/explore/tags/${tag}/`);
        const youtube = external(
          'youtube',
          'Search on YouTube',
          `https://www.youtube.com/results?search_query=${encodeURIComponent(v.title)}`,
        );
        const copy = iconControl('button', 'copy', `Copy link: ${v.title}`);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(url);
            toast('Link copied.');
          } catch {
            toast('Couldn’t copy. Select the address instead.');
          }
        });
        actions.append(share, instagram, youtube, copy);
        body.append(actions);

        // Circled X at the end of the row. The row disappears with focus on it, so pass focus
        // to the remove button now in its place (or the heading once the list is empty).
        const remove = iconControl('button', 'remove', `Remove: ${v.title}`, 'icon-btn icon-btn--remove');
        remove.addEventListener('click', () => {
          if (!list) return;
          const refocus = focusAfterRemoval(list, item, '.icon-btn--remove', heading);
          const next = load().filter((x) => x.path !== v.path);
          save(next);
          render(next);
          refocus();
          toast('Page removed.');
        });
        item.append(body, remove);
        return item;
      }),
    );
    empty.hidden = visits.length > 0;
  }

  // Record this page, newest first, once per path. Paths end in a slash, as the live site serves
  // them; one saved before that ("/work") counts as the same page.
  const slash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
  const here: Visit = {
    path: slash(location.pathname),
    title: document.title.replace(/ · Swiss Minimal$/, ''),
    at: Date.now(),
  };
  const visits = [here, ...load().filter((v) => slash(v.path) !== here.path)].slice(0, MAX);
  save(visits);
  render(visits);
</script>
