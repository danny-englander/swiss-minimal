---
// A section of list rows: 2px rule, then a header on the rows' grid
// (range label over the numbers, h2 over the names), then the rows.
interface Props {
  id: string;
  title: string;
  /** e.g. "01–06" */
  range: string;
  /** Hidden by the Work filter when none of its rows match. */
  filterable?: boolean;
}
const { id, title, range, filterable } = Astro.props;
---

<section
  class="mb-16 border-t-2 border-ink pt-3"
  aria-labelledby={id}
  data-filter-section={filterable ? '' : undefined}
>
  <div class="grid gap-1 pb-6 md:grid-cols-[3rem_1fr_1.75rem] md:items-baseline md:gap-x-2">
    <!-- "01–06" is wider than 3rem at the rows' inset, so it sits nearer the edge -->
    <p class="num small muted whitespace-nowrap font-medium md:pl-2">{range}</p>
    <h2 class="h2" id={id}>{title}</h2>
  </div>
  <ul>
    <slot />
  </ul>
</section>
