---
// One numbered list row (ListRow in COMPONENTS.md). The end slot takes an indicator or arrow.
// Phones: number and end slot share the first line, the name stacks under them.
// From 768px: one line on the section's grid (number, name, end slot).
// With `favorite`, a star sits in the end slot, beside the title link rather than inside it.
// `numStyle` sets the number in a circle, outlined or solid (NumberCircle in COMPONENTS.md).
import FavoriteButton from '../design/kit/astro/FavoriteButton.astro';
import NumCircle from '../design/kit/astro/NumCircle.astro';

interface Props {
  num: number;
  title: string;
  meta?: string;
  href?: string;
  active?: boolean;
  category?: string;
  /** A stable id for the item; needed for `favorite` and to find the row from a script. */
  id?: string;
  favorite?: boolean;
  numStyle?: 'plain' | 'circle' | 'solid';
}
const { num, title, meta, href, active, category, id, favorite, numStyle = 'plain' } = Astro.props;
---

<li
  class:list={[
    'row grid grid-cols-[1fr_auto] gap-y-1 p-4 md:items-baseline md:gap-x-2 md:px-0',
    // A circled number is wider, so its column is too: room for the circle clear of the edge.
    numStyle === 'plain' ? 'md:grid-cols-[3rem_1fr_2.75rem]' : 'md:grid-cols-[4rem_1fr_2.75rem]',
  ]}
  data-active={active ? 'true' : undefined}
  aria-current={active ? 'true' : undefined}
  data-category={category}
  data-item={id}
>
  <!-- md:pl-5 keeps the number clear of the active row's 6px edge; a circle sits at 1rem in its
       wider column, 10px clear of the edge and as far again from the name -->
  <span
    class:list={[
      'num small muted col-start-1 row-start-1 font-medium',
      numStyle === 'plain' ? 'md:pl-5' : 'md:pl-4',
    ]}
  >
    {numStyle === 'plain' ? String(num).padStart(2, '0') : <NumCircle value={num} solid={numStyle === 'solid'} />}
  </span>
  <span class="col-span-2 row-start-2 md:col-span-1 md:col-start-2 md:row-start-1">
    {
      href ? (
        <a class="title block underline-offset-4 hover:underline" href={href}>{title}</a>
      ) : (
        <span class="title block">{title}</span>
      )
    }
    {meta && <span class="small muted block">{meta}</span>}
  </span>
  <!-- The star's 44px touch target overlaps the row's padding instead of making the row taller -->
  <span class="col-start-2 row-start-1 -my-2.5 flex items-center justify-center self-center md:col-start-3">
    {favorite && id ? <FavoriteButton id={id} name={title} /> : <slot />}
  </span>
</li>
