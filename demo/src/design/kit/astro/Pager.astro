---
// Numbered pages of a long list (Pager in COMPONENTS.md): the step back, the page numbers and
// the step on, under a 2px rule. Pass the page you are on, how many there are, and how to link to
// a page. With many pages it shows the first, the last and the two beside the current one, with
// an ellipsis for each gap. Nothing is drawn when there is only one page.
interface Props {
  /** The page you are on, from 1. */
  current: number;
  /** How many pages there are. */
  total: number;
  /** The address of a page, e.g. (n) => (n === 1 ? '/blog/' : `/blog/page/${n}/`). */
  url: (page: number) => string;
  /** What the pages are, for the landmark's name and the links' names: "Blog pages". */
  label?: string;
  /** The step back and the step on. One or two words each. */
  prev?: string;
  next?: string;
}
const { current, total, url, label = 'Pages', prev = 'Previous', next = 'Next' } = Astro.props;

// 1 … 4 5 6 … 12: the ends, the current page and its neighbors, and a gap marker where pages are left out.
const shown = [...new Set([1, current - 1, current, current + 1, total])]
  .filter((n) => n >= 1 && n <= total)
  .sort((a, b) => a - b);
const items: (number | 'gap')[] = shown.flatMap((n, i) => (i > 0 && n - shown[i - 1] > 1 ? ['gap' as const, n] : [n]));
---

{
  total > 1 && (
    <nav class="pager" aria-label={label}>
      {current > 1 ? (
        <a class="pager-step" href={url(current - 1)} rel="prev">
          <span aria-hidden="true">←&nbsp;</span>
          {prev}
        </a>
      ) : (
        <span />
      )}
      <ol class="pager-pages">
        {items.map((item) =>
          item === 'gap' ? (
            <li class="pager-gap" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              <a
                href={url(item)}
                aria-current={item === current ? 'page' : undefined}
                aria-label={`Page ${item} of ${total}`}
              >
                {item}
              </a>
            </li>
          ),
        )}
      </ol>
      {current < total && (
        <a class="pager-step pager-next" href={url(current + 1)} rel="next">
          {next}
          <span aria-hidden="true">&nbsp;→</span>
        </a>
      )}
    </nav>
  )
}
