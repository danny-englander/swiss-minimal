---
// The top of an article (PostHeader in COMPONENTS.md): a small label back to the index, the
// title, an optional lead, then the byline under a 2px rule. Use it in place of a Hero or a
// PageTitle on a post's page, and put the text in a `.post-body` after it.
interface Props {
  title: string;
  lead?: string;
  /** The small label over the title, e.g. { label: 'Blog', href: '/blog/' }. One or two words. */
  back?: { label: string; href?: string };
  /** YYYY-MM-DD, the day it was published. */
  date: string;
  author?: string;
  /** Reading time in minutes. */
  minutes?: number;
  /** Topics, listed in the byline. */
  tags?: string[];
}
const { title, lead, back, date, author, minutes, tags = [] } = Astro.props;

// Dates are plain days, so format them in UTC or they can slip back a day.
const formatted = new Date(date).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<header class="post-header">
  {
    back &&
      (back.href ? (
        <a class="post-header-label" href={back.href}>
          {back.label}
        </a>
      ) : (
        <p class="post-header-label">{back.label}</p>
      ))
  }
  <h1 class="post-header-title">{title}</h1>
  {lead && <p class="lead post-header-lead">{lead}</p>}
  <dl class="post-meta">
    <div>
      <dt>Published</dt>
      <dd><time datetime={date}>{formatted}</time></dd>
    </div>
    {
      author && (
        <div>
          <dt>By</dt>
          <dd>{author}</dd>
        </div>
      )
    }
    {
      minutes && (
        <div>
          <dt>Reading</dt>
          <dd class="num">{minutes} min</dd>
        </div>
      )
    }
    {
      tags.length > 0 && (
        <div>
          <dt>Topics</dt>
          <dd>{tags.join(', ')}</dd>
        </div>
      )
    }
  </dl>
</header>
