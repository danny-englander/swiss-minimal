{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd demo && PATH=$HOME/.nvm/versions/node/v24.21.0/bin:$PATH npx astro dev --port 4321"],
      "port": 4321
    },
    {
      "name": "fleuron",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["-m", "http.server", "4399", "--bind", "127.0.0.1", "--directory", "explorations/mcsweeneys"],
      "port": 4399
    },
    {
      "name": "fleuron-network",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["-m", "http.server", "4400", "--bind", "0.0.0.0", "--directory", "explorations/mcsweeneys"],
      "port": 4400
    },
    {
      "name": "explorations-network",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["-m", "http.server", "4401", "--bind", "0.0.0.0", "--directory", "explorations"],
      "port": 4401
    }
  ]
}
